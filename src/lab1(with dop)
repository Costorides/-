#include <stdio.h>

float dm_in_week(float v) {
    return v*10000.0*(60*24*7);
}

int main(void)
{
    float L;
    float t1;
    float t2;
    float v;

    scanf("%f", & L);
    scanf("%f", & t1);
    scanf("%f", & t2);

    v = dm_in_week((L / t1 - L / t2) / 2.0);
    printf("Speed of river = %.2f dm/week \n", v);

    return 0;
}

